#!/bin/sh
set -e

case "$1" in
    remove|purge)
        if systemctl --version >/dev/null 2>&1; then
            systemctl --global disable mdt >/dev/null 2>&1 || true
            # Detiene el servicio en la sesion grafica activa (best-effort).
            if command -v loginctl >/dev/null 2>&1; then
                loginctl list-sessions --no-legend 2>/dev/null | while read -r _ _ user seat _rest; do
                    [ -n "$user" ] || continue
                    [ "$user" != "root" ] || continue
                    [ -n "$seat" ] && [ "$seat" != "-" ] || continue
                    case "$user" in
                        *[!a-z0-9_-]*) continue ;;
                    esac
                    systemctl --user --machine="$user@.host" stop mdt >/dev/null 2>&1 || true
                done
            fi
        fi
        ;;
esac

exit 0