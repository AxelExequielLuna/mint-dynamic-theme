#!/bin/sh
set -e

case "$1" in
    configure)
        if systemctl --version >/dev/null 2>&1; then
            # Enable the service for all users (starts on every login).
            systemctl --global enable mdt >/dev/null 2>&1 || true
            # Try to start it immediately in the active graphical session (best-effort).
            if command -v loginctl >/dev/null 2>&1; then
                loginctl list-sessions --no-legend 2>/dev/null | while read -r _ _ user seat _rest; do
                    [ -n "$user" ] || continue
                    [ "$user" != "root" ] || continue
                    [ -n "$seat" ] && [ "$seat" != "-" ] || continue
                    case "$user" in
                        *[!a-z0-9_-]*) continue ;;
                    esac
                    systemctl --user --machine="$user@.host" start mdt >/dev/null 2>&1 || true
                done
            fi
        fi
        echo "=============================================================="
        echo " Mint Dynamic Theme installed."
        echo " The mdt service has been enabled automatically and starts"
        echo " on every login. Status:"
        echo "   systemctl --user is-enabled mdt"
        echo "   mdt status"
        echo " The tray icon will start on the next login automatically."
        echo "=============================================================="
        ;;
esac

exit 0