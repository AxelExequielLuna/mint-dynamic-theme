#!/bin/sh
set -e

case "$1" in
    configure)
        if systemctl --version >/dev/null 2>&1; then
            systemctl --user daemon-reload 2>/dev/null || true
        fi
        echo "=============================================================="
        echo " Mint Dynamic Theme instalado."
        echo " Para arrancar el daemon ahora:"
        echo "   systemctl --user enable --now mdt"
        echo " El tray icon se iniciara solo en el proximo inicio de sesion."
        echo "=============================================================="
        ;;
esac

exit 0