#!/bin/sh
set -e

case "$1" in
    configure)
        if systemctl --version >/dev/null 2>&1; then
            # Enable the service for all users (starts on every login via the
            # autostart tray). We deliberately do NOT also start it right now
            # through loginctl/--machine=: when run as root that was tearing
            # down the active graphical session on some setups.
            systemctl --global enable mdt >/dev/null 2>&1 || true
        fi
        echo "=============================================================="
        echo " Mint Dynamic Theme installed."
        echo " The mdt service is enabled and will start on your next login."
        echo " To start it right now:"
        echo "   systemctl --user start mdt"
        echo " Status:"
        echo "   systemctl --user is-enabled mdt"
        echo "   mdt status"
        echo "=============================================================="
        ;;
esac

exit 0