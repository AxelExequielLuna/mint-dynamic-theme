# ==================== WALLPAPER ====================
def get_wallpaper_gsettings() -> Optional[str]:
    """
    Obtiene la ruta del wallpaper usando gsettings (Cinnamon/MATE).

    Returns:
        Ruta absoluta al wallpaper o None si falla
    """
    try:
        result = subprocess.run(
            [
                "gsettings",
                "get",
                DESKTOP_ENVIRONMENTS[DESKTOP]["schema"],
                DESKTOP_ENVIRONMENTS[DESKTOP]["key"],
            ],
            capture_output=True,
            text=True,
            check=True,
            timeout=SUBPROCESS_TIMEOUT
        )

        uri = result.stdout.strip().strip("'\"")

        if not uri or uri == "''":
            return None

        if uri.startswith("file://"):
            path = unquote(urlparse(uri).path)
            return path if os.path.exists(path) else None

        return None

    except subprocess.TimeoutExpired:
        log.error("Timeout obteniendo wallpaper con gsettings")
        return None
    except subprocess.CalledProcessError as e:
        log.error(f"Error ejecutando gsettings: {e}")
        return None
    except Exception as e:
        log.error(f"Error inesperado obteniendo wallpaper: {e}", exc_info=True)
        return None


def get_wallpaper_xfce() -> Optional[str]:
    """
    Obtiene la ruta del wallpaper para XFCE.

    Returns:
        Ruta absoluta al wallpaper más reciente o None si falla
    """
    try:
        dir_path = Path(CONFIG["xfce_wallpaper_dir"])

        if not dir_path.exists():
            return None

        files = list(dir_path.rglob("*"))
        files = [f for f in files if f.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")]

        if not files:
            return None

        # Obtener el más reciente
        most_recent = max(files, key=lambda p: p.stat().st_mtime)
        return str(most_recent)

    except OSError as e:
        log.error(f"Error accediendo a directorio XFCE: {e}")
        return None
    except Exception as e:
        log.error(f"Error inesperado obteniendo wallpaper XFCE: {e}", exc_info=True)
        return None


def get_current_wallpaper() -> Optional[str]:
    """
    Obtiene la ruta del wallpaper actual según el entorno de escritorio.

    Returns:
        Ruta absoluta al wallpaper o None
    """
    if DESKTOP in ["cinnamon", "mate"]:
        return get_wallpaper_gsettings()
    elif DESKTOP == "xfce":
        return get_wallpaper_xfce()
    else:
        return None


# ==================== COLOR ====================
@lru_cache(maxsize=CONFIG["cache_size"])
def get_dominant_color(path: str) -> Optional[Tuple[int, int, int]]:
    """
    Extrae el color dominante de una imagen.

    Args:
        path: Ruta a la imagen

    Returns:
        Tupla RGB (r, g, b) o None si falla
    """
    if not COLORTHIEF_AVAILABLE:
        return None

    file_path = Path(path)

    if not file_path.exists():
        log.error(f"Archivo no existe: {path}")
        return None

    if not file_path.is_file():
        log.error(f"No es un archivo: {path}")
        return None

    try:
        color_thief = ColorThief(path)
        color = color_thief.get_color(quality=CONFIG["color_quality"])

        if not isinstance(color, (tuple, list)) or len(color) != 3:
            log.error(f"ColorThief retornó formato inválido: {color}")
            return None

        return tuple(int(c) for c in color)

    except (IOError, OSError) as e:
        log.error(f"Error leyendo imagen {path}: {e}")
        return None
    except ValueError as e:
        log.error(f"Error procesando color de {path}: {e}")
        return None
    except Exception as e:
        log.error(f"ColorThief falló inesperadamente en {path}: {e}", exc_info=True)
        return None


def rgb_to_hsl(r: int, g: int, b: int) -> Tuple[float, float, float]:
    """
    Convierte RGB a HSL.

    Args:
        r, g, b: Valores RGB (0-255)

    Returns:
        Tupla (h, s, l) donde h está en [0, 360) y s, l en [0, 1]
    """
    r_norm, g_norm, b_norm = r / 255.0, g / 255.0, b / 255.0

    cmax = max(r_norm, g_norm, b_norm)
    cmin = min(r_norm, g_norm, b_norm)
    delta = cmax - cmin

    # Luminosidad
    l = (cmax + cmin) / 2

    # Saturación
    if delta == 0:
        return 0.0, 0.0, l

    s = delta / (2 - cmax - cmin) if l > 0.5 else delta / (cmax + cmin)

    # Matiz
    if cmax == r_norm:
        h = ((g_norm - b_norm) / delta + (6 if g_norm < b_norm else 0)) * 60
    elif cmax == g_norm:
        h = ((b_norm - r_norm) / delta + 2) * 60
    else:  # cmax == b_norm
        h = ((r_norm - g_norm) / delta + 4) * 60

    return h, s, l


def get_theme_for_color(r: int, g: int, b: int) -> str:
    """
    Determina el tema apropiado basado en el color RGB.

    Args:
        r, g, b: Valores RGB (0-255)

    Returns:
        Nombre del tema correspondiente
    """
    # Validar entrada
    if not all(0 <= x <= 255 for x in (r, g, b)):
        log.error(f"RGB fuera de rango: ({r}, {g}, {b})")
        return "Green"

    h, s, l = rgb_to_hsl(r, g, b)

    # Colores muy oscuros -> Gris
    if l < MIN_LIGHTNESS_THRESHOLD:
        return "Grey"

    # Colores desaturados
    if s < MIN_SATURATION_GRAYSCALE:
        return "Sand" if l > SAND_LIGHTNESS_THRESHOLD else "Grey"

    # Colores muy claros y saturados (excepto azules/morados)
    if l > MAX_LIGHTNESS_THRESHOLD and s > HIGH_SATURATION_THRESHOLD and not (160 <= h <= 260):
        return "Sand"

    # Rangos de matiz para colores
    color_ranges = [
        (350, 360, "Pink"),
        (330, 350, "Pink"),
        (300, 330, "Purple"),
        (260, 280, "Navy"),
        (240, 260, "Blue"),
        (220, 240, "Blue"),
        (200, 220, "Aqua"),
        (185, 200, "Teal"),
        (165, 185, "Cyan"),
        (140, 165, "Green"),
        (100, 140, "Green"),
        (80, 100, "Green"),
        (65, 80, "Yellow"),
        (55, 65, "Yellow"),
        (45, 55, "Orange"),
        (35, 45, "Orange"),
        (20, 35, "Red"),
        (0, 20, "Red"),
    ]

    for start, end, color in color_ranges:
        if start <= h < end:
            # Ajustes especiales basados en luminosidad
            if color == "Yellow" and l > YELLOW_TO_SAND_LIGHTNESS:
                return "Sand"
            if color == "Orange" and l < ORANGE_TO_BROWN_LIGHTNESS:
                return "Sand"
            if color == "Blue" and l < BLUE_TO_NAVY_LIGHTNESS:
                return "Navy"
            return color

    return "Green"


# ==================== APLICAR TEMA ====================
def theme_exists(theme_type: str, theme_name: str) -> bool:
    """
    Verifica si un tema existe en el sistema.

    Args:
        theme_type: Tipo de tema ('gtk', 'icon', 'desktop')
        theme_name: Nombre del tema

    Returns:
        True si el tema existe
    """
    base_dir = "/usr/share/themes" if theme_type in ["gtk", "desktop"] else "/usr/share/icons"
    theme_path = os.path.join(base_dir, theme_name)

    return os.path.exists(theme_path) and os.path.isdir(theme_path)


def apply_theme_setting(theme_type: str, theme_name: str) -> bool:
    """
    Aplica una configuración de tema específica.

    Args:
        theme_type: Tipo de tema ('gtk', 'icon', 'desktop')
        theme_name: Nombre del tema a aplicar

    Returns:
        True si se aplicó exitosamente
    """
    try:
        if DESKTOP == "xfce":
            subprocess.run(
                [
                    "xfconf-query",
                    "-c",
                    "xsettings",
                    "-p",
                    DESKTOP_ENVIRONMENTS["xfce"]["keys"][theme_type],
                    "-s",
                    theme_name,
                ],
                check=True,
                timeout=SUBPROCESS_TIMEOUT,
                capture_output=True
            )
        else:
            subprocess.run(
                [
                    "gsettings",
                    "set",
                    DESKTOP_ENVIRONMENTS[DESKTOP]["schemas"][theme_type],
                    DESKTOP_ENVIRONMENTS[DESKTOP]["keys"][theme_type],
                    theme_name,
                ],
                check=True,
                timeout=SUBPROCESS_TIMEOUT,
                capture_output=True
            )
        return True

    except subprocess.TimeoutExpired:
        log.error(f"Timeout aplicando tema {theme_type}: {theme_name}")
        return False
    except subprocess.CalledProcessError as e:
        log.error(f"Error aplicando tema {theme_type} '{theme_name}': {e}")
        return False
    except Exception as e:
        log.error(f"Error inesperado aplicando tema {theme_type}: {e}", exc_info=True)
        return False

def apply_theme(color: str) -> None:
    """
    Aplica el tema completo basado en un color.

    Args:
        color: Nombre del color del tema
    """
    themes = THEME_MAPPING.get(color, THEME_MAPPING["Green"])
    applied_count = 0

    for theme_type, theme_name in themes.items():
        if theme_type in DESKTOP_ENVIRONMENTS[DESKTOP].get("schemas", {}):
            if theme_exists(theme_type, theme_name):
                if apply_theme_setting(theme_type, theme_name):
                    applied_count += 1
            else:
                log.error(f"Tema no encontrado: {theme_type} = {theme_name}")

    # Notificación dinámica
    if CONFIG_MANAGER.get_notifications() and applied_count > 0:
        try:
            subprocess.run(
                ["notify-send", "Tema Dinámico", f"Tema aplicado: {color}"],
                check=False,
                timeout=SUBPROCESS_TIMEOUT,
                capture_output=True
            )
        except Exception as e:
            log.error(f"Error enviando notificación: {e}")


# ==================== DAEMON ====================
class DynamicThemeDaemon:
    """
    Daemon principal que monitorea cambios de wallpaper y aplica temas.
    """

    def __init__(self):
        self.last_wallpaper: Optional[str] = None
        self.last_theme: Optional[str] = None
        self.last_color: Optional[Tuple[int, int, int]] = None
        self.paused: bool = False
        self.running: bool = True
        self.observer: Optional[Observer] = None

    def run(self) -> None:
        """Inicia el daemon y el monitoreo"""
        try:
            self._process()
        except Exception as e:
            log.error(f"Error en procesamiento inicial: {e}", exc_info=True)

        if DESKTOP in ["cinnamon", "mate"]:
            self._monitor_gsettings()
        elif DESKTOP == "xfce":
            self._monitor_xfce()
        else:
            self._fallback_monitor()

    def _monitor_gsettings(self) -> None:
        """Monitorea cambios usando gsettings (Cinnamon/MATE)"""
        try:
            proc = subprocess.Popen(
                [
                    "gsettings",
                    "monitor",
                    DESKTOP_ENVIRONMENTS[DESKTOP]["schema"],
                    DESKTOP_ENVIRONMENTS[DESKTOP]["key"],
                ],
                stdout=subprocess.PIPE,
                text=True
            )

            try:
                for line in proc.stdout:
                    if not self.running:
                        break
                    if not self.paused:
                        self._process()
            finally:
                proc.terminate()
                try:
                    proc.wait(timeout=SUBPROCESS_TIMEOUT)
                except subprocess.TimeoutExpired:
                    proc.kill()

        except Exception as e:
            log.error(f"Error en monitoreo gsettings: {e}", exc_info=True)

    def _monitor_xfce(self) -> None:
        """Monitorea cambios en XFCE"""
        if not WATCHDOG_AVAILABLE:
            log.error("watchdog no disponible, usando fallback")
            self._fallback_monitor()
            return

        try:
            daemon_instance = self

            class WallpaperChangeHandler(FileSystemEventHandler):
                """Handler para cambios en el directorio de wallpapers"""

                def on_modified(self, event):
                    if daemon_instance.paused or not daemon_instance.running:
                        return

                    if "backdrop" in event.src_path or event.src_path.endswith(('.jpg', '.png')):
                        daemon_instance._process()

            self.observer = Observer()
            self.observer.schedule(
                WallpaperChangeHandler(),
                CONFIG["xfce_wallpaper_dir"],
                recursive=False
            )
            self.observer.start()

            try:
                while self.running:
                    time.sleep(1)
            except KeyboardInterrupt:
                pass
            finally:
                self.observer.stop()
                self.observer.join(timeout=SUBPROCESS_TIMEOUT)

        except Exception as e:
            log.error(f"Error en monitoreo XFCE: {e}", exc_info=True)
            self._fallback_monitor()

    def _fallback_monitor(self) -> None:
        """Monitor de respaldo con polling"""
        while self.running:
            try:
                time.sleep(10)
                if not self.paused:
                    self._process()
            except Exception as e:
                log.error(f"Error en fallback monitor: {e}", exc_info=True)

    def _process(self) -> None:
        """Procesa el wallpaper actual y aplica el tema correspondiente.
        Nota: el color dominante se representa aquí como un nombre de color (str),
        p. ej. 'Blue', 'Green', 'Red', etc. No se trabaja con tuplas RGB.
        """
        try:
            wallpaper = get_current_wallpaper()

            # Si no hay wallpaper o no ha cambiado, no hacemos nada
            if not wallpaper or wallpaper == self.last_wallpaper:
                return

            # Normalizar ruta del wallpaper actual para comparaciones robustas
            try:
                normalized_wallpaper = os.path.normcase(os.path.realpath(wallpaper))
            except Exception:
                normalized_wallpaper = wallpaper

            # Verificamos si el wallpaper fue seteado manualmente por el usuario.
            # Buscamos en el historial la entrada más reciente que coincida con este wallpaper.
            manual_color = None
            try:
                historial = MANUAL_WALL.get_history()
                # Iterar en orden inverso para obtener la entrada más reciente primero
                for item in reversed(historial):
                    wp = item.get("wallpaper")
                    col = item.get("color")
                    if not wp:
                        continue
                    try:
                        nw = os.path.normcase(os.path.realpath(wp))
                    except Exception:
                        nw = wp
                    if nw == normalized_wallpaper:
                        manual_color = col  # puede ser None o nombre del color (str)
                        break
            except Exception:
                # Si falla al leer el historial, continuamos con el procesamiento normal
                manual_color = None

            used_manual = False
            theme = None
            detected_color_name = None

            if isinstance(manual_color, str) and manual_color.strip():
                # Usar el color almacenado en el historial (normalizar capitalización)
                theme = manual_color.capitalize()
                used_manual = True
            else:
                rgb = get_dominant_color(wallpaper)
                if not rgb:
                    self.last_wallpaper = wallpaper
                    return

                detected_color_name = get_theme_for_color(*rgb)


                # Si no se obtuvo un nombre de color válido, actualizar last_wallpaper y salir
                if not detected_color_name or not isinstance(detected_color_name, str):
                    self.last_wallpaper = wallpaper
                    return

                theme = detected_color_name.capitalize()

            if theme != self.last_theme:
                apply_theme(theme)
                self.last_theme = theme
                # No manejamos RGB aquí; last_color no contiene una tupla RGB cuando usamos nombres
                self.last_color = None

            # Actualizar last_wallpaper para no re-procesar repetidamente
            self.last_wallpaper = wallpaper

        except Exception as e:
            log.error(f"Error procesando wallpaper: {e}", exc_info=True)

    def stop(self) -> None:
        """Detiene el daemon de forma limpia"""
        self.running = False
        if self.observer:
            self.observer.stop()


