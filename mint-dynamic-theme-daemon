def is_pid_running(pid: int) -> bool:
    """
    Verifica si un PID está corriendo.

    Args:
        pid: Process ID

    Returns:
        True si el proceso está corriendo
    """
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # Existe pero no tenemos permisos
    except Exception:
        return False


def get_current_info() -> Dict[str, Any]:
    """
    Obtiene información del estado actual del daemon.

    Returns:
        Diccionario con información del wallpaper y tema
    """
    current = MANUAL_WALL.get_current()
    wallpaper = get_current_wallpaper()
    color = None
    theme = None
    if current.get("wallpaper") != None and current.get("wallpaper") == wallpaper:
        wallpaper = current.get("wallpaper")
        theme = current.get("color")
    else:
        color = get_dominant_color(wallpaper) if wallpaper else None
        theme = get_theme_for_color(*color) if color else "Desconocido"
    themes = THEME_MAPPING.get(theme, {"gtk": "?", "icon": "?", "desktop": "?"})

    return {
        "wallpaper": wallpaper,
        "dominant_color": {
            "r": color[0],
            "g": color[1],
            "b": color[2]
        } if color else {"RGB": "Set by user"},
        "theme": theme,
        "applied": {
            "gtk": themes["gtk"],
            "icon": themes["icon"],
            "desktop": themes["desktop"],
        },
        "desktop_environment": DESKTOP,
        "notifications": CONFIG_MANAGER.get_notifications(),
    }


def cmd_stop() -> None:
    """Detiene el daemon"""
    if not os.path.exists(CONFIG["pid_file"]):
        print("El daemon no está corriendo.")
        return

    try:
        with open(CONFIG["pid_file"], 'r') as f:
            pid = int(f.read().strip())

        if is_pid_running(pid):
            os.kill(pid, signal.SIGTERM)

            # Esperar hasta 5 segundos a que termine
            for _ in range(50):
                if not is_pid_running(pid):
                    break
                time.sleep(0.1)
            else:
                # Forzar si no terminó
                os.kill(pid, signal.SIGKILL)

            print("Daemon detenido.")
        else:
            os.remove(CONFIG["pid_file"])
            print("PID file obsoleto eliminado (proceso no estaba corriendo).")

    except ValueError:
        print("Error: PID file contiene datos inválidos.")
        os.remove(CONFIG["pid_file"])
    except PermissionError:
        print("Error: No hay permisos para detener el proceso.")
    except Exception as e:
        print(f"Error deteniendo daemon: {e}")


def cmd_status() -> None:
    """Muestra el estado del daemon"""
    if os.path.exists(CONFIG["pid_file"]):
        try:
            with open(CONFIG["pid_file"], 'r') as f:
                pid = int(f.read().strip())

            status = "running" if is_pid_running(pid) else "dead"
            print(json.dumps({
                "status": status,
                "pid": pid,
                "desktop": DESKTOP
            }, indent=2))

        except Exception as e:
            print(json.dumps({
                "status": "error",
                "error": str(e)
            }, indent=2))
    else:
        print(json.dumps({"status": "stopped"}, indent=2))


