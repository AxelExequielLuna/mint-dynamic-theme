def detect_desktop() -> str:
    """
    Detecta el entorno de escritorio actual.

    Returns:
        Nombre del entorno: 'cinnamon', 'mate', 'xfce' o 'cinnamon' por defecto
    """
    de = os.getenv("XDG_CURRENT_DESKTOP", "").lower()

    if "cinnamon" in de:
        return "cinnamon"
    elif "mate" in de:
        return "mate"
    elif "xfce" in de:
        return "xfce"
    else:
        return "cinnamon"  # Fallback por defecto


