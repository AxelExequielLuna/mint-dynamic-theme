class ManualWallpaper:
    """
    Gestiona el set persistente de asociaciones wallpaper->color.
    Solo almacena el wallpaper y el color (sin timestamps).
    Thread-safe para lecturas/escrituras.
    """

    def __init__(self, max_entries: int = 256):
        self.file = CONFIG["wall_file"]
        self.mtime = 0
        # Interno: lista de entradas {'wallpaper': str|None, 'color': str|None}
        self.history = []  # type: list
        self.max_entries = max_entries
        import threading
        self._lock = threading.RLock()
        self.load()

    def _normalize_value(self, v):
        if isinstance(v, str) and v.lower() == "none":
            return None
        return v

    def _normalize_entry(self, wp, col) -> dict:
        wp = self._normalize_value(wp)
        col = self._normalize_value(col)
        return {"wallpaper": wp, "color": col}

    def load(self) -> None:
        """Carga las asociaciones desde el archivo si ha sido modificado"""
        with self._lock:
            if not os.path.exists(self.file):
                # Intentar crear el directorio si es necesario antes de guardar
                try:
                    dirn = os.path.dirname(self.file)
                    if dirn:
                        os.makedirs(dirn, exist_ok=True)
                except Exception:
                    pass
                # Inicializar archivo vacío con estructura de walls
                self.history = []
                self.save()
                return

            try:
                mtime = os.path.getmtime(self.file)
                if mtime <= self.mtime:
                    return

                with open(self.file, 'r') as f:
                    content = f.read()
                    if not content.strip():
                        self.history = []
                    else:
                        loaded = json.loads(content)
                        raw_entries = []

                        # Diferentes formatos de compatibilidad
                        if isinstance(loaded, dict):
                            if "walls" in loaded:
                                walls = loaded["walls"]
                                if isinstance(walls, list):
                                    raw_entries = walls
                                elif isinstance(walls, dict):
                                    # Puede ser {"wallpaper":..., "color":...} o mapping wallpaper->color
                                    if "wallpaper" in walls or "color" in walls:
                                        raw_entries = [walls]
                                    else:
                                        # mapping: wallpaper_path -> color_name
                                        for k, v in walls.items():
                                            raw_entries.append({"wallpaper": k, "color": v})
                            elif "history" in loaded and isinstance(loaded["history"], list):
                                raw_entries = loaded["history"]
                            elif "wallpaper" in loaded or "color" in loaded:
                                raw_entries = [loaded]
                            else:
                                # Posible formato mapping directo: {"/path/to/wall": "Blue", ...}
                                # Convertir en lista de entradas
                                is_mapping = all(isinstance(k, str) and isinstance(v, str) for k, v in loaded.items())
                                if is_mapping:
                                    for k, v in loaded.items():
                                        raw_entries.append({"wallpaper": k, "color": v})
                                else:
                                    raw_entries = []
                        elif isinstance(loaded, list):
                            raw_entries = loaded
                        else:
                            raw_entries = []

                        # Normalizar cada entrada y construir una lista donde la última
                        # ocurrencia de un mismo wallpaper prevalece.
                        dedup_map = {}  # temporary map to preserve last occurrence
                        order = []  # maintain insertion order of last occurrences
                        for item in raw_entries:
                            if isinstance(item, dict):
                                # If item looks like {"wallpaper": ..., "color": ...}
                                if "wallpaper" in item or "color" in item:
                                    wp = self._normalize_value(item.get("wallpaper"))
                                    col = self._normalize_value(item.get("color"))
                                    key = wp
                                    # Remove previous occurrence so that this becomes the last
                                    if key in dedup_map:
                                        try:
                                            order.remove(key)
                                        except ValueError:
                                            pass
                                    dedup_map[key] = col
                                    order.append(key)
                                else:
                                    # Might be mapping inside a dict: {"/path": "Blue"}
                                    for k, v in item.items():
                                        wp = self._normalize_value(k)
                                        col = self._normalize_value(v)
                                        key = wp
                                        if key in dedup_map:
                                            try:
                                                order.remove(key)
                                            except ValueError:
                                                pass
                                        dedup_map[key] = col
                                        order.append(key)
                            # ignore non-dict items

                        normalized = []
                        for k in order:
                            normalized.append({"wallpaper": k, "color": dedup_map.get(k)})

                        # Keep only up to max_entries most recent (i.e., last items)
                        if len(normalized) > self.max_entries:
                            normalized = normalized[-self.max_entries:]

                        self.history = normalized

                self.mtime = mtime

            except json.JSONDecodeError as e:
                log.error(f"Error parseando JSON en wall file: {e}")
                self.history = []
            except OSError as e:
                log.error(f"Error leyendo wall file: {e}")

    def save(self) -> None:
        """Guarda las asociaciones al archivo (atomic write)"""
        with self._lock:
            try:
                temp_file = f"{self.file}.tmp"
                payload = {"walls": self.history}
                with open(temp_file, 'w') as f:
                    json.dump(payload, f, indent=2)

                os.replace(temp_file, self.file)
                try:
                    self.mtime = os.path.getmtime(self.file)
                except OSError:
                    pass

            except OSError as e:
                log.error(f"Error guardando wall file: {e}")
            except Exception as e:
                log.error(f"Error inesperado guardando wall file: {e}", exc_info=True)

    def get_current(self) -> dict:
        """
        Devuelve la asociación más reciente (wallpaper y color) o {'wallpaper': None, 'color': None}
        """
        with self._lock:
            self.load()
            if not self.history:
                return {"wallpaper": None, "color": None}
            last = self.history[-1]
            return {"wallpaper": last.get("wallpaper"), "color": last.get("color")}

    def get_history(self) -> list:
        """Devuelve una copia del historial completo (lista de entradas)"""
        with self._lock:
            self.load()
            return [dict(entry) for entry in self.history]

    def add_wall(self, wallpaper: Optional[str], color: Optional[str]) -> None:
        """
        Añade o actualiza la asociación wallpaper->color y la persiste.
        Evita duplicados: si el wallpaper ya existía se actualiza su color y
        se considera la entrada como la más reciente.
        """
        with self._lock:
            self.load()
            entry = self._normalize_entry(wallpaper, color)

            # If last entry is identical, just return
            if self.history:
                last = self.history[-1]
                if last.get("wallpaper") == entry["wallpaper"] and last.get("color") == entry["color"]:
                    return

            # Remove any existing entry with same wallpaper (to update it and move to end)
            new_history = [e for e in self.history if e.get("wallpaper") != entry["wallpaper"]]
            new_history.append(entry)

            # Truncate to max_entries
            if len(new_history) > self.max_entries:
                new_history = new_history[-self.max_entries:]

            self.history = new_history
            self.save()

    def clear_history(self) -> None:
        """Limpia todas las asociaciones persistidas en el archivo"""
        with self._lock:
            self.history = []
            self.save()


