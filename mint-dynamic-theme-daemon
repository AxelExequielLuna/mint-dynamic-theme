def cmd_notify(state: str) -> None:
    """
    Controla las notificaciones.

    Args:
        state: 'on' o 'off'
    """
    state_lower = state.lower()

    if state_lower in ["on", "true", "1"]:
        CONFIG_MANAGER.set_notifications(True)
        print("✓ Notificaciones activadas (efecto inmediato).")
    elif state_lower in ["off", "false", "0"]:
        CONFIG_MANAGER.set_notifications(False)
        print("✓ Notificaciones desactivadas (efecto inmediato).")
    else:
        print("Error: Uso correcto: notify on|off")
        sys.exit(1)


def cmd_set(color):
    """
    Establece el color del tema manualmente y guarda el wallpaper actual
    en las asociaciones para su posterior reutilización.

    Args:
        color: Color del tema (por ejemplo, 'azul', 'rojo', 'verde')
    """
    if not isinstance(color, str):
        print("Error: color inválido")
        sys.exit(1)

    color_norm = color.capitalize()
    # Aplicar tema
    if color_norm not in THEME_MAPPING:
        print(f"Color desconocido: {color_norm}")
        return

    apply_theme(color_norm)

    # Obtener el wallpaper actual y guardarlo en las asociaciones con el color seleccionado
    wallpaper = get_current_wallpaper()
    try:
        MANUAL_WALL.add_wall(wallpaper, color_norm)
    except Exception as e:
        log.error(f"Error guardando wallpaper manual en asociaciones: {e}", exc_info=True)

    print(f"✓ Color actualizado a {color_norm}")


def cmd_clear_wall_history():
    """
    Limpia las asociaciones de wallpapers manuales persistidas en wall_file.
    """
    try:
        MANUAL_WALL.clear_history()
        print("✓ Asociaciones de wallpapers limpiadas.")
    except Exception as e:
        print(f"Error limpiando asociaciones: {e}")
        log.error(f"Error limpiando asociaciones de walls: {e}", exc_info=True)

def cmd_list():
    """
    Lista los colores de temas disponibles dentro de THEME_MAPPING
    Imprime los nombres en filas con 5 columnas.
    """
    print("Colores de temas disponibles:\n")
    items = list(THEME_MAPPING.keys())

    if not items:
        print("(ninguno)")
        return

    cols = 5
    # ancho uniforme por columna (añadir un pequeño espacio de separación)
    col_width = max(len(name) for name in items) + 2

    for i in range(0, len(items), cols):
        row = items[i:i + cols]
        line = "".join(name.ljust(col_width) for name in row)
        print(line.rstrip())
    print("")

def check_daemon_already_running() -> bool:
    """
    Verifica si el daemon ya está corriendo.

    Returns:
        True si ya está corriendo
    """
    if not os.path.exists(CONFIG["pid_file"]):
        return False

    try:
        with open(CONFIG["pid_file"], 'r') as f:
            old_pid = int(f.read().strip())

        if is_pid_running(old_pid):
            print(f"El daemon ya está corriendo con PID {old_pid}.")
            return True
        else:
            print(f"Limpiando PID file obsoleto (PID {old_pid} no está corriendo)...")
            os.remove(CONFIG["pid_file"])
            return False

    except ValueError:
        print("PID file corrupto, eliminando...")
        os.remove(CONFIG["pid_file"])
        return False
    except Exception as e:
        log.error(f"Error verificando PID: {e}")
        return False


def main():
    """Función principal"""

    # Verificar dependencia crítica
    if not COLORTHIEF_AVAILABLE:
        print("Error: Falta la librería colorthief")
        print("Instalar con: pip3 install colorthief")
        sys.exit(1)

    # Procesar comandos
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()

        commands = {
            "stop": cmd_stop,
            "status": cmd_status,
            "info": cmd_info,
            "about": cmd_about,
            "list": cmd_list,
            "clear": cmd_clear_wall_history,
        }

        if cmd in commands:
            commands[cmd]()
        elif cmd == "notify":
            if len(sys.argv) > 2:
                cmd_notify(sys.argv[2])
            else:
                print("Error: Uso correcto: notify on|off")
                sys.exit(1)
        elif cmd == "set":
            if len(sys.argv) > 2:
                cmd_set(sys.argv[2])
            else:
                print("Error: Uso correcto: set <color>")
                sys.exit(1)
        else:
            print(f"Comando desconocido: {cmd}")
            print("Comandos disponibles: stop, status, info, about, notify, set, clear, list")
            sys.exit(1)

        return

    # Iniciar daemon
    if check_daemon_already_running():
        sys.exit(1)

    print("Iniciando Mint Dynamic Theme Daemon...")
    print(f"Entorno detectado: {DESKTOP.title()}")
    print(f"PID: {os.getpid()}")
    print(f"Log: {CONFIG['log_file']}")

    daemon = DynamicThemeDaemon()

    # Manejar señales
    def signal_handler(signum, frame):
        print("\nDeteniendo daemon...")
        daemon.stop()
        sys.exit(0)

    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)

    # Ejecutar con context manager para PID
    with pid_file_manager(CONFIG["pid_file"]):
        print("Daemon iniciado correctamente.")
        daemon.run()


if __name__ == "__main__":
    main()
